#!/usr/bin/env bash
# Garde-fou local avant `git push` — rejoue la validation de la CI
# (.github/workflows/tests.yml) pour un retour immédiat, sans attendre
# l'aller-retour GitHub Actions.
#
# Activation (une fois par clone) :
#   git config core.hooksPath .githooks
#
# Désactivation ponctuelle (push d'urgence) :
#   git push --no-verify
#
# N'exécute PAS mypy (lent à installer/lancer) : la CI s'en charge.
# Ici on couvre le plus rentable et le plus rapide : lint + suite de tests.
set -euo pipefail

# Garde-fou secret : la clé privée de licence ne doit JAMAIS partir sur
# le remote. `.gitignore` ne protège pas d'un `git add -f`, et une fuite
# est irréversible (la clé publique est figée dans tous les binaires déjà
# distribués). On vérifie donc ce qui est réellement SUIVI.
echo "→ aucun secret suivi par git"
if git ls-files --error-unmatch private.key >/dev/null 2>&1 \
   || git ls-files | grep -Eq '(^|/)private\.key$|\.pem$|\.p12$|\.pfx$'; then
    echo "✗ ABANDON : un fichier de clé est suivi par git." >&2
    git ls-files | grep -E '(^|/)private\.key$|\.pem$|\.p12$|\.pfx$' >&2 || true
    echo "  Retirez-le de l'index :  git rm --cached <fichier>" >&2
    echo "  (et considérez la clé comme compromise si elle a été poussée)" >&2
    exit 1
fi

echo "→ ruff check ."
ruff check .

echo "→ tests (xvfb si dispo)"
if command -v xvfb-run >/dev/null 2>&1; then
    xvfb-run -a python3 -m unittest discover tests
else
    # Sans framebuffer virtuel, les tests Tk se skippent proprement.
    python3 -m unittest discover tests
fi

echo "✓ validation locale OK"
